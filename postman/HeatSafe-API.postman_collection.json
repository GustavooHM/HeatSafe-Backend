    {
      "name": "01 - Saúde e autenticação",
      "item": [
        {
          "name": "Health - API disponível",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Verifica se a API está respondendo. Não exige token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status healthy', function () { pm.expect(pm.response.json().status).to.eql('healthy'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Token - Administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/token",
            "description": "Token exclusivamente demonstrativo; endpoint disponível somente em Development."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token de administrador emitido', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json(); pm.collectionVariables.set('adminToken', body.accessToken);",
                  "pm.test('Token preenchido', function () { pm.expect(body.accessToken).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ]
        },
