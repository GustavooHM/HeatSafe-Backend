    {
      "name": "03 - Integração ESP32 (Dispositivo)",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{deviceToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Enviar leitura - simular perigo extremo e divergência do sensor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dispositivoId\": \"HS-001\",\n  \"temperatura\": 35.2,\n  \"umidade\": 80,\n  \"indiceCalor\": 42.1,\n  \"nivel\": \"PERIGO\",\n  \"movimento\": false,\n  \"dataHora\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/leituras",
            "description": "Dados fictícios. O servidor recalcula o índice: 35,2 °C e 80% de umidade produzem índice superior a 54 °C na fórmula implementada, demonstrando que o servidor não confia na classificação PERIGO enviada pelo dispositivo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Leitura aceita HTTP 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Servidor devolveu índice calculado', function () { pm.expect(body.indiceCalorCalculado).to.be.a('number'); });",
                  "pm.test('Servidor classifica independentemente do dispositivo', function () { pm.expect(body.nivel).to.eql('PERIGO_EXTREMO'); });"
                ]
              }
            }
          ]
        },
