{
  "ConnectionStrings": {
    "HeatSafe": "Data Source=heatsafe.db;Cache=Shared"
  },
  "Jwt": {
    "Issuer": "HeatSafe",
    "Audience": "HeatSafe.Clients",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  "Forecast": {
    "BaseUrl": "http://localhost:8080/",
    "Station": "A701",
    "TimeoutSeconds": 5
  },
  "Monitoring": {
    "IntervalSeconds": 60,
    "DangerConfirmationMinutes": 20,
    "ForecastHour": 19
  },
  "PriorityWeights": {
    "Heat": 0.40,
    "Inactivity": 0.25,
    "Hydration": 0.15,
    "Vulnerability": 0.10,
    "UnconfirmedAlert": 0.10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
